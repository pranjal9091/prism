# ==============================================================================
# PRism Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# DO NOT commit .env containing real credentials to version control.
# ==============================================================================

# GitHub Authentication
# Required for live GitHub API requests and publishing review comments.
GITHUB_TOKEN=

# GitHub API Base URL (defaults to public GitHub REST API; override for Enterprise)
GITHUB_API_URL=https://api.github.com

# Optional Default Repository (owner/repo format)
GITHUB_DEFAULT_REPO=

# Webhook Secret (Required in production for HMAC-SHA256 signature verification)
GITHUB_WEBHOOK_SECRET=

# Review Publishing Settings
GITHUB_PUBLISHING_ENABLED=false
AUTO_PUBLISH_REVIEWS=true
PUBLISH_INLINE_COMMENTS=true

# Security & Approvals
# Optional API key required for approval endpoints (X-PRISM-API-KEY).
# In local development, leaving this empty permits open access.
PRISM_API_KEY=

# Persistent SQLite Storage Paths
CHECKPOINT_DB_PATH=prism_checkpoints.db
REVIEW_DB_PATH=prism_reviews.db

# Milestone 6: Observability & Tracing (Langfuse)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Application Logging & Deployment Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# Request Timeouts & Memory Safety Limits
GITHUB_TIMEOUT_SECONDS=15.0
MAX_DIFF_CHARACTERS=200000
MAX_FILE_CHARACTERS=100000
MCP_SERVER_NAME=prism-github-mcp
